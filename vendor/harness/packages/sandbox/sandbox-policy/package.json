{
  "name": "@deepseek-ai/dsh-sandbox-policy",
  "version": "0.2.1-rc.2",
  "private": true,
  "description": "Per-call sandbox policy resolver and current model context: deployment fallbacks plus each session's mode and workspace root, shared by every enforcing capability family",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/sandbox/sandbox-policy"
  },
  "exports": {
    "./package.json": "./package.json",
    "./src/*": "./src/*",
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./src/index.ts"
    },
    "./locale/*.json": "./locale/*.json"
  },
  "dependencies": {
    "@deepseek-ai/cordis": "4.0.5",
    "@deepseek-ai/dsh-agent": "0.2.1-rc.2",
    "@deepseek-ai/dsh-sandbox": "0.2.1-rc.2",
    "@deepseek-ai/dsh-session": "0.2.1-rc.2",
    "@deepseek-ai/dsh-session-projection": "0.2.1-rc.2",
    "@deepseek-ai/dsh-system-prompt": "0.2.1-rc.2",
    "@deepseek-ai/schemastery": "3.18.5",
    "zod": "4.4.3"
  },
  "main": "./src/index.ts",
  "types": "./lib/types/index.d.ts"
}
