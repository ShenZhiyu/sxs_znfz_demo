{
  "name": "@deepseek-ai/dsh-session-format-catalog",
  "version": "0.2.1-rc.2",
  "description": "Build-static first-party Session format codec and migration catalog",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/session/session-format-catalog"
  },
  "private": true,
  "main": "./src/index.ts",
  "types": "./lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./src/index.ts"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./message-projections": {
      "types": "./lib/types/message-projections.d.ts",
      "default": "./src/message-projections.ts"
    }
  },
  "dependencies": {
    "@deepseek-ai/dsh-session-format": "0.2.1-rc.2",
    "@deepseek-ai/dsh-compaction-image-offload": "0.2.1-rc.2",
    "@deepseek-ai/dsh-session": "0.2.1-rc.2",
    "@deepseek-ai/dsh-session-format-v3-to-v4": "0.2.1-rc.2",
    "@deepseek-ai/dsh-session-format-v0-to-v1": "0.2.1-rc.2",
    "@deepseek-ai/dsh-session-format-v1-to-v2": "0.2.1-rc.2",
    "@deepseek-ai/dsh-session-format-v2-to-v3": "0.2.1-rc.2"
  }
}
