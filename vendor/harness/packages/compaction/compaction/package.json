{
  "name": "@deepseek-ai/dsh-compaction",
  "version": "0.2.1-rc.2",
  "description": "Abstract compaction service seam (ctx.compaction) for the DeepSeek Harness",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/compaction/compaction"
  },
  "private": true,
  "main": "./src/index.ts",
  "types": "./lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./src/index.ts"
    },
    "./types": {
      "types": "./lib/types/types.d.ts",
      "default": "./src/types.ts"
    },
    "./checkpoint": {
      "types": "./lib/types/checkpoint.d.ts",
      "default": "./src/checkpoint.ts"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "dependencies": {
    "@deepseek-ai/cordis": "4.0.5",
    "@deepseek-ai/dsh-session": "0.2.1-rc.2",
    "@deepseek-ai/dsh-commands": "0.2.1-rc.2",
    "@deepseek-ai/dsh-llm": "0.2.1-rc.2",
    "@deepseek-ai/dsh-brand": "0.2.1-rc.2"
  }
}
