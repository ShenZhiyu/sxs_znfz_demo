{
  "name": "@deepseek-ai/dsh-plugin-manager",
  "version": "0.2.1-rc.2",
  "private": true,
  "description": "Current-profile plugin and bundle management shared by dsh CLI, Web and agent tools",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/boot/plugin-manager"
  },
  "exports": {
    "./package.json": "./package.json",
    "./src/*": "./src/*",
    "./types": {
      "types": "./lib/types/types.d.ts",
      "default": "./src/types.ts"
    },
    "./operations": {
      "types": "./lib/types/operations.d.ts",
      "default": "./src/operations.ts"
    },
    "./locale/*.json": "./locale/*.json"
  },
  "dependencies": {
    "@deepseek-ai/cordis": "4.0.5",
    "@deepseek-ai/cordis-plugin-loader": "1.0.6",
    "@deepseek-ai/dsh-app-boot": "0.2.1-rc.2",
    "@deepseek-ai/dsh-atomic-write": "0.2.1-rc.2",
    "@deepseek-ai/dsh-brand": "0.2.1-rc.2",
    "@deepseek-ai/dsh-host-plugin-inventory": "0.2.1-rc.2",
    "@deepseek-ai/dsh-package-manifest": "0.2.1-rc.2",
    "@deepseek-ai/dsh-subprocess": "0.2.1-rc.2",
    "execa": "^10.0.1"
  }
}
