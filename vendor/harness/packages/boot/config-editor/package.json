{
  "name": "@deepseek-ai/dsh-config-editor",
  "version": "0.2.1-rc.2",
  "private": true,
  "description": "Persist plugin configuration through profile patches and Loader reconciliation",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/boot/config-editor"
  },
  "exports": {
    "./package.json": "./package.json",
    "./src/*": "./src/*",
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./src/index.ts"
    },
    "./locale/*.json": "./locale/*.json"
  },
  "dependencies": {
    "@deepseek-ai/cordis": "4.0.5",
    "@deepseek-ai/cordis-plugin-include": "1.0.10",
    "@deepseek-ai/cordis-plugin-loader": "1.0.6",
    "@deepseek-ai/dsh-app-boot": "0.2.1-rc.2",
    "@deepseek-ai/dsh-atomic-write": "0.2.1-rc.2",
    "@deepseek-ai/dsh-hmr": "0.2.1-rc.2",
    "js-yaml": "^4.3.2",
    "yaml": "^2.8.1"
  },
  "main": "./src/index.ts",
  "types": "./lib/types/index.d.ts"
}
