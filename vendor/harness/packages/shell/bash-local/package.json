  "description": "Local-subprocess implementation of the DeepSeek Harness bash executor seam",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/shell/bash-local"
  },
  "private": true,
  "main": "./src/index.ts",
