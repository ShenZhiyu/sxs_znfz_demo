{
  "name": "@deepseek-ai/dsh-skill-filesystem",
  "version": "0.2.1-rc.2",
  "description": "Local filesystem skill provider for the DeepSeek Harness",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/skill/skill-filesystem"
  },
  "private": true,
  "main": "./src/index.ts",
  "types": "./lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./src/index.ts"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "dependencies": {
    "chokidar": "5.0.0",
    "@deepseek-ai/schemastery": "3.18.5",
    "yaml": "^2.4.2",
    "@deepseek-ai/dsh-fs": "0.2.1-rc.2",
    "@deepseek-ai/dsh-home-paths": "0.2.1-rc.2",
    "@deepseek-ai/dsh-skill": "0.2.1-rc.2",
    "@deepseek-ai/cordis": "4.0.5"
  }
}
