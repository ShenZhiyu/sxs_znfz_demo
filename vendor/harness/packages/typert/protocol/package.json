{
  "name": "@deepseek-ai/dsh-typert-protocol",
  "version": "0.2.1-rc.2",
  "private": true,
  "description": "Compiler-independent Remote metadata and Typert provider protocols",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/typert/protocol"
  },
  "exports": {
    "./package.json": "./package.json",
    "./src/*": "./src/*",
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./src/index.ts"
    },
    "./types": {
      "types": "./lib/types/types.d.ts",
      "default": "./src/types.ts"
    },
    "./remote-info": {
      "types": "./lib/types/remote-info.d.ts",
      "default": "./src/remote-info.ts"
    }
  },
  "dependencies": {
    "@deepseek-ai/cordis": "4.0.5",
    "@deepseek-ai/dsh-brand": "0.2.1-rc.2",
    "zod": "^4.4.3"
  },
  "main": "./src/index.ts",
  "types": "./lib/types/index.d.ts"
}
