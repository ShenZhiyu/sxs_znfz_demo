{
  "name": "@deepseek-ai/dsh-user-approval",
  "version": "0.2.1-rc.2",
  "private": true,
  "description": "User-approval seam (ctx.approval) for the DeepSeek Harness: one-shot permission decisions dispatched to composed answerers over the approval/request waterfall, fail-closed by default",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/interaction/user-approval"
  },
  "exports": {
    "./package.json": "./package.json",
    "./src/*": "./src/*",
    "./types": {
      "types": "./lib/types/types.d.ts",
      "default": "./src/types.ts"
    },
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./src/index.ts"
    },
    "./locale/*.json": "./locale/*.json"
  },
  "dependencies": {
    "@deepseek-ai/cordis": "4.0.5",
    "@deepseek-ai/dsh-agent": "0.2.1-rc.2",
    "@deepseek-ai/dsh-brand": "0.2.1-rc.2",
    "@deepseek-ai/dsh-llm": "0.2.1-rc.2",
    "@deepseek-ai/dsh-scope": "0.2.1-rc.2",
    "@deepseek-ai/dsh-session": "0.2.1-rc.2",
    "@deepseek-ai/dsh-system-prompt": "0.2.1-rc.2",
    "@deepseek-ai/schemastery": "3.18.5"
  },
  "main": "./src/index.ts",
  "types": "./lib/types/index.d.ts"
}
